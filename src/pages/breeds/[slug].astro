---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import BreedCard from '../../components/BreedCard.astro';
import LineCta from '../../components/LineCta.astro';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const all = await getCollection('breeds');
  return all.map((breed) => ({ params: { slug: breed.id }, props: { breed, all } }));
}
const { breed, all } = Astro.props;
const d = breed.data;
const { Content } = await render(breed);
const ogImg = await getImage({ src: d.photo, width: 1200, format: 'jpg' });
const kind = d.animal === 'dog' ? '犬種' : '猫種';
const levels = [
  { label: 'お手入れの手間', v: d.levels.care },
  { label: '運動量', v: d.levels.exercise },
  { label: 'お留守番の得意さ', v: d.levels.alone },
  { label: 'はじめての方への飼いやすさ', v: d.levels.beginner },
];
const articles = (await getCollection('articles', (a) => a.data.animal === d.animal || a.data.animal === 'both'))
  .sort((a, b) => +b.data.publishDate - +a.data.publishDate).slice(0, 3);
const others = all.filter((b) => b.id !== breed.id && b.data.animal === d.animal).slice(0, 4);
---
<Base title={`${d.name}の性格とお手入れ｜犬種・猫種図鑑`} description={`${d.name}の性格、お手入れ、向いている暮らし、お迎え前に確かめたいことを、ペットショップのスタッフがまとめました。${d.lead}`} image={ogImg.src}>
  <article>
    <div class="container">
      <nav aria-label="パンくずリスト" class="bc"><a href="/">トップ</a> › <a href="/breeds/">犬種・猫種図鑑</a> › {d.name}</nav>
    </div>
    <div class="head container">
      <Image src={d.photo} alt={d.photoAlt} widths={[640, 1080]} sizes="(min-width: 960px) 520px, 100vw" class="photo" loading="eager" />
      <div class="head-body">
        <p class="kind">{kind}</p>
        <h1>{d.name}<span>{d.nameEn}</span></h1>
        <p class="lead">{d.lead}</p>
        <dl class="spec">
          <div><dt>大きさ</dt><dd>{d.size}</dd></div>
          <div><dt>毛のタイプ</dt><dd>{d.coat}</dd></div>
          <div><dt>原産</dt><dd>{d.origin}</dd></div>
        </dl>
      </div>
    </div>

    <div class="container narrow">
      {d.sample && <p class="sample">この図鑑はテスト用の見本です。本番では、獣医師の監修のうえで掲載します。</p>}

      <section class="box">
        <h2 class="box-title">スタッフの目安</h2>
        <ul class="levels">
          {levels.map((l) => (
            <li>
              <span>{l.label}</span>
              <span class="dots" role="img" aria-label={`5段階中${l.v}`}>{[1, 2, 3, 4, 5].map((n) => <i class={n <= l.v ? 'on' : ''}></i>)}</span>
            </li>
          ))}
        </ul>
        <p class="box-note">※一頭一頭、性格や体質はちがいます。あくまで目安としてご覧ください。</p>
      </section>

      <div class="prose"><Content /></div>

      <section class="box">
        <h2 class="box-title">こんな暮らしに向いています</h2>
        <ul class="list">{d.fits.map((f) => <li>{f}</li>)}</ul>
      </section>

      <section class="box box--check">
        <h2 class="box-title">お迎えの前に確かめたいこと</h2>
        <ul class="list">{d.checks.map((c) => <li>{c}</li>)}</ul>
        <p class="box-note">家族みんなで、これからの10年以上の暮らしを思い浮かべながら話し合ってみてください。</p>
      </section>

      <section class="meet">
        <h2>{d.name}について、お店で相談できます</h2>
        <p>お近くのお店にいない場合も、取り寄せやほかの店舗からの移動を相談できます（仮）。お迎えのときは、店頭でスタッフが直接ご説明します。</p>
        <a class="btn btn--primary" href={SITE.storesUrl}>お店に相談する（仮リンク）</a>
      </section>

      <LineCta compact />
    </div>

    {others.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="sec-title">ほかの{kind}</h2>
          <ul class="breeds">{others.map((b) => <li><BreedCard breed={b} /></li>)}</ul>
        </div>
      </section>
    )}
    <section class="section related">
      <div class="container">
        <h2 class="sec-title">あわせて読みたい</h2>
        <div class="grid grid--3">{articles.map((a) => <ArticleCard article={a} />)}</div>
      </div>
    </section>
  </article>
</Base>

<style>
  .bc { font-size: 0.8125rem; color: var(--c-text-sub); padding-top: 16px; }
  .bc a { color: var(--c-text-sub); }
  .head { display: grid; gap: 20px; margin: 16px auto 32px; }
  @media (min-width: 960px) { .head { grid-template-columns: 520px 1fr; gap: 48px; align-items: center; } }
  .head :global(.photo) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-m); }
  .kind { margin: 0; font-size: 0.8125rem; font-weight: 700; color: var(--c-primary-ink); letter-spacing: 0.2em; }
  h1 { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h1); letter-spacing: 0.1em; margin: 4px 0 12px; }
  h1 span { display: block; font-family: var(--font-body); font-size: 0.875rem; font-weight: 400; color: var(--c-text-sub); letter-spacing: 0.05em; }
  .lead { margin: 0 0 20px; line-height: 2; }
  .spec { margin: 0; border-top: 1px solid var(--c-line); }
  .spec div { display: flex; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--c-line); font-size: 0.9375rem; }
  .spec dt { width: 6em; flex: none; color: var(--c-text-sub); }
  .spec dd { margin: 0; }
  .sample { font-size: 0.8125rem; background: var(--c-bg-soft); padding: 10px 14px; color: var(--c-text-sub); }

  .box { background: #fff; border: 1px solid var(--c-line); padding: 22px 20px; margin: 32px 0; }
  .box--check { border-top: 3px solid var(--c-primary); }
  .box-title { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; letter-spacing: 0.08em; margin: 0 0 14px; }
  .box-note { font-size: 0.8125rem; color: var(--c-text-sub); margin: 12px 0 0; }
  .levels { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .levels li { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 0.9375rem; }
  .dots { display: flex; gap: 5px; flex: none; }
  .dots i { width: 12px; height: 12px; border-radius: 50%; background: var(--c-line); }
  .dots i.on { background: var(--c-primary); }
  .list { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; line-height: 1.9; }

  .meet { background: var(--c-bg-soft); padding: 28px 20px; text-align: center; margin: 32px 0; }
  .meet h2 { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; letter-spacing: 0.08em; margin: 0 0 10px; }
  .meet p { margin: 0 0 18px; font-size: 0.9375rem; line-height: 1.9; color: var(--c-text-sub); }

  .prose :global(h2) {
    font-size: var(--fs-h2); margin: 56px 0 20px; padding-bottom: 14px; letter-spacing: 0.08em;
    border-bottom: 1px solid var(--c-line); position: relative;
  }
  .prose :global(h2)::after { content: ''; position: absolute; left: 0; bottom: -1px; width: 56px; height: 2px; background: var(--c-primary); }
  .prose :global(p) { margin: 0 0 1.4em; line-height: 2; }

  .breeds { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px 16px; }
  @media (min-width: 768px) { .breeds { grid-template-columns: repeat(4, 1fr); gap: 32px 20px; } }
  .related { background: #fff; }
</style>
