---
// B案のトップ：全画面スライダー → 短い前書き → 写真を大きく使った入口
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Mascots from '../components/Mascots.astro';
import LineCta from '../components/LineCta.astro';
import AmbassadorVideos from '../components/AmbassadorVideos.astro';
import EventCard from '../components/EventCard.astro';
import { SITE, CATEGORIES } from '../data/site';
import imgFood from '../assets/photos/worry-food.jpg';
import imgSenior from '../assets/photos/worry-senior.jpg';
import imgLiving from '../assets/photos/worry-living.jpg';
import catFood from '../assets/photos/category-food.jpg';
import catSenior from '../assets/photos/category-senior.jpg';
import catLiving from '../assets/photos/category-living.jpg';
import storeImg from '../assets/photos/store-band.webp';
// 図鑑の入口（Canvaで作成）
import breedDog from '../assets/photos/breed-entry-dog.jpg';
import breedCat from '../assets/photos/breed-entry-cat.jpg';
import guideImg from '../assets/photos/hero-dog-cat.jpg';

const events = (await getCollection('events')).sort((a, b) => +b.data.publishDate - +a.data.publishDate).slice(0, 4);
const articles = (await getCollection('articles')).sort((a, b) => +b.data.publishDate - +a.data.publishDate);

const worries = [
  { no: '01', label: '食欲', title: 'ごはんを、食べてくれない。', text: '好み、環境、体調。理由をひとつずつ見直すヒント。', href: '/articles/dog-not-eating/', img: imgFood },
  { no: '02', label: 'シニア', title: '年をとって、食が細くなった。', text: '香り、温度、粒の大きさ。毎日の食事でできる工夫。', href: '/articles/senior-cat-appetite/', img: imgSenior },
  { no: '03', label: '暮らし', title: 'お留守番が、心配。', text: '室温、いたずら防止、水の置き場所。安心の部屋づくり。', href: '/articles/home-alone-room/', img: imgLiving },
];
const breedEntries = [
  { href: '/breeds/#dog', name: '犬種図鑑', lead: '性格やお手入れ、お迎え前に知っておきたいこと。', img: breedDog },
  { href: '/breeds/#cat', name: '猫種図鑑', lead: '性格や暮らし方、向いているご家庭の目安。', img: breedCat },
];
const catImg: Record<string, ImageMetadata> = { food: catFood, senior: catSenior, living: catLiving };
const priority = CATEGORIES.filter((c) => c.priority);
const others = CATEGORIES.filter((c) => !c.priority);
---
<Base>
  <HeroSlider slot="hero" />

  <section class="intro" id="intro">
    <div class="container narrow">
      <p class="intro-lead">毎日のごはんから、<br />シニア期の暮らしまで。</p>
      <p class="intro-text">犬と猫のことを、いちばん近くで見てきた<br class="pc" />ペットショップのスタッフが、やさしくお答えします。</p>
    </div>
  </section>

  <section class="section worries-wrap">
    <div class="container">
      <h2 class="sec-title"><small>POPULAR</small>よく読まれている悩み</h2>
      <ul class="worries">
        {worries.map((w) => (
          <li>
            <a class="worry" href={w.href}>
              <Image src={w.img} alt="" widths={[480, 800, 1200]} sizes="(min-width: 960px) 33vw, 100vw" />
              <div class="worry-body">
                <span class="worry-no">{w.no}　{w.label}</span>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section news">
    <div class="container">
      <h2 class="sec-title"><small>NEW</small>新着記事</h2>
      <div class="grid grid--3">{articles.slice(0, 6).map((a) => <ArticleCard article={a} />)}</div>
    </div>
  </section>

  <section class="section events-wrap">
    <div class="container">
      <h2 class="sec-title"><small>EVENT &amp; CAMPAIGN</small>イベント・キャンペーン</h2>
      <ul class="events">{events.map((e) => <li><EventCard event={e} /></li>)}</ul>
      <p class="more"><a class="btn btn--ghost" href="/events/">お知らせをすべて見る</a></p>
    </div>
  </section>

  <Mascots />

  <AmbassadorVideos />


  <LineCta />

  <section class="section">
    <div class="container">
      <h2 class="sec-title"><small>CATEGORY</small>カテゴリーから探す</h2>
      <ul class="cat-main">
        {priority.map((c) => (
          <li>
            <a href={`/category/${c.slug}/`}>
              <Image src={catImg[c.slug]} alt="" widths={[480, 800]} sizes="(min-width: 768px) 33vw, 100vw" />
              <span class="cat-text">
                <span class="cat-name">{c.name}</span>
                <span class="cat-lead">{c.lead}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <ul class="cat-sub">
        {others.map((c) => <li><a href={`/category/${c.slug}/`}>{c.name}<span aria-hidden="true">→</span></a></li>)}
      </ul>
    </div>
  </section>

  <section class="section breeds-wrap">
    <div class="container">
      <h2 class="sec-title"><small>BREEDS</small>犬種・猫種図鑑</h2>
      <p class="breeds-lead">性格やお手入れ、向いている暮らし。<br class="pc" />お迎えの前に知っておきたいことを、スタッフがまとめました。</p>
      <ul class="breeds">
        {breedEntries.map((b) => (
          <li>
            <a class="breed-entry" href={b.href}>
              <Image src={b.img} alt="" widths={[400, 800, 1200]} sizes="(min-width: 960px) 540px, 50vw" />
              <span class="be-text"><span class="be-name">{b.name}</span><span class="be-lead">{b.lead}</span></span>
            </a>
          </li>
        ))}
      </ul>
      <a class="guide" href="/articles/welcome-guide/">
        <Image src={guideImg} alt="" widths={[480, 800]} sizes="(min-width: 768px) 400px, 100vw" />
        <span class="guide-body">
          <span class="guide-label">はじめての方へ</span>
          <span class="guide-title">はじめてのお迎えガイド</span>
          <span class="guide-text">準備するもの、お迎えの日の流れ、最初の1か月にすること。<span aria-hidden="true">→</span></span>
        </span>
      </a>
    </div>
  </section>

  <section class="store">
    <Image src={storeImg} alt="店内のフェンスに並んで、うれしそうに上を見上げる犬と猫たち" widths={[640, 1080, 1584]} sizes="100vw" class="store-img" />
    <div class="store-body">
      <p class="store-title">お近くのワンニャンハウスで、<br />相談できます。</p>
      <p class="store-text">ごはんのこと、暮らしのこと。ペットのことをよく知るスタッフが、店頭でお話をうかがいます。</p>
      <div class="store-btns">
        <a class="btn btn--primary" href={SITE.storesUrl}>店舗一覧を見る（仮リンク）</a>
        <a class="btn btn--ghost" href="/contact/">お問い合わせ</a>
      </div>
    </div>
  </section>

  <div class="line-foot"><LineCta /></div>
</Base>

<style>
  .pc { display: none; }
  @media (min-width: 640px) { .pc { display: inline; } }

  .intro { padding-block: 72px 24px; text-align: center; }
  .intro-lead { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.5rem, 1.1rem + 2vw, 2.25rem); line-height: 1.8; letter-spacing: 0.15em; margin: 0 0 20px; }
  .intro-text { margin: 0; color: var(--c-text-sub); line-height: 2.2; }

  .worries { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  @media (min-width: 960px) { .worries { grid-template-columns: repeat(3, 1fr); gap: 20px; } }
  .worry { position: relative; display: block; overflow: hidden; color: #fff; text-decoration: none; aspect-ratio: 4 / 5; }
  @media (max-width: 959px) { .worry { aspect-ratio: 4 / 3; } }
  .worry :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; transition: transform 1.2s ease; }
  .worry:hover :global(img) { transform: scale(1.06); }
  .worry::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 35%, rgba(0,0,0,.7) 100%); }
  .worry-body { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; padding: 24px; }
  .worry-no { font-size: 0.75rem; letter-spacing: 0.25em; }
  .worry h3 { font-size: clamp(1.15rem, 1rem + 0.8vw, 1.35rem); margin: 6px 0 6px; letter-spacing: 0.08em; }
  .worry p { margin: 0; font-size: 0.875rem; line-height: 1.8; opacity: .95; }

  .news { background: #fff; }

  .cat-main { list-style: none; padding: 0; margin: 0 0 32px; display: grid; gap: 16px; }
  @media (min-width: 768px) { .cat-main { grid-template-columns: repeat(3, 1fr); } }
  .cat-main a { display: block; color: var(--c-text); text-decoration: none; }
  .cat-main :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; transition: opacity .3s; }
  .cat-main a:hover :global(img) { opacity: .85; }
  .cat-text { display: block; padding: 14px 2px 0; }
  .cat-name { display: block; font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; letter-spacing: 0.1em; }
  .cat-lead { display: block; font-size: 0.875rem; color: var(--c-text-sub); line-height: 1.8; margin-top: 4px; }
  .cat-sub { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--c-line); display: grid; }
  @media (min-width: 768px) { .cat-sub { grid-template-columns: repeat(2, 1fr); column-gap: 32px; } }
  .cat-sub a { display: flex; justify-content: space-between; padding: 16px 4px; border-bottom: 1px solid var(--c-line); color: var(--c-text); text-decoration: none; font-family: var(--font-display); font-weight: 600; letter-spacing: 0.08em; }
  .cat-sub a:hover { color: var(--c-primary-ink); }

  .events-wrap { background: var(--c-bg-soft); }
  .events { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  @media (min-width: 960px) { .events { grid-template-columns: repeat(2, 1fr); gap: 24px; } }
  .more { text-align: center; margin: 32px 0 0; }

  .guide { display: grid; margin-top: 24px; background: var(--c-bg-warm); color: var(--c-text); text-decoration: none; border: 1px solid var(--c-line); }
  @media (min-width: 768px) { .guide { grid-template-columns: 400px 1fr; align-items: center; } }
  .guide :global(img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; }
  .guide-body { display: grid; gap: 6px; padding: 20px; }
  @media (min-width: 768px) { .guide-body { padding: 24px 36px; } }
  .guide-label { font-size: 0.75rem; font-weight: 700; color: var(--c-primary-ink); letter-spacing: 0.15em; }
  .guide-title { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.25rem, 1.05rem + 1vw, 1.6rem); letter-spacing: 0.1em; }
  .guide-text { font-size: 0.875rem; color: var(--c-text-sub); line-height: 1.8; }
  .guide:hover .guide-title { color: var(--c-primary-ink); }

  .breeds-wrap { background: #fff; }
  .breeds-lead { text-align: center; color: var(--c-text-sub); margin: -12px 0 32px; line-height: 2; }
  .breeds { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (min-width: 768px) { .breeds { gap: 24px; } }
  .breed-entry { display: block; color: var(--c-text); text-decoration: none; }
  .breed-entry :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; transition: opacity .3s; }
  .breed-entry:hover :global(img) { opacity: .85; }
  .be-text { display: block; padding: 12px 2px 0; }
  .be-name { display: block; font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; letter-spacing: 0.1em; }
  .be-lead { display: block; font-size: 0.875rem; color: var(--c-text-sub); line-height: 1.8; margin-top: 4px; }

  /* 画像は切らずに全部見せ、文字は下に置く。その下のLINEはフッターと間を空けずにつなげる */
  .store { margin-top: var(--space-section); background: var(--c-bg-soft); }
  .line-foot { margin-bottom: calc(var(--space-section) * -1); }
  .store :global(.store-img) { display: block; width: 100%; height: auto; }
  .store-body { max-width: 720px; margin: 0 auto; padding: 40px var(--gutter) 56px; text-align: center; }
  .store-title { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.35rem, 1.1rem + 1vw, 1.75rem); line-height: 1.8; letter-spacing: 0.1em; margin: 0 0 12px; }
  .store-text { margin: 0 auto 24px; font-size: 0.9375rem; line-height: 2; color: var(--c-text-sub); max-width: 34em; }
  .store-btns { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  @media (max-width: 480px) { .store-btns .btn { flex: 1 1 100%; } }
</style>
