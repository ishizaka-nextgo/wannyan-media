---
interface Props { q: string; }
const { q } = Astro.props;
---
<div class="qa">
  <p class="qa-q"><span aria-hidden="true">Q</span><span class="visually-hidden">質問：</span>{q}</p>
  <div class="qa-a"><span class="qa-mark" aria-hidden="true">A</span><span class="visually-hidden">回答：</span><div><slot /></div></div>
</div>

<style>
  .qa { background: #fff; border: 1px solid var(--c-line); padding: 20px 22px; margin: 20px 0; }
  .qa-q, .qa-a { display: flex; gap: 12px; align-items: flex-start; }
  .qa-q { font-weight: 700; margin: 0 0 12px; padding-bottom: 12px; border-bottom: 1px dashed var(--c-line); }
  .qa-q > span:first-child, .qa-mark {
    flex: none; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center;
    font-family: var(--font-heading); font-weight: 700; line-height: 1;
  }
  .qa-q > span:first-child { background: var(--c-primary); color: var(--c-text); }
  .qa-mark { background: var(--c-accent-strong); color: #fff; }
  .qa-a :global(p) { margin: 0 0 8px; }
  .qa-a :global(p:last-child) { margin: 0; }
</style>
