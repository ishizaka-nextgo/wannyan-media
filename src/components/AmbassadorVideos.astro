---
// アンバサダー（飼い主さん）から集めた縦長動画の投稿枠
// 追加のしかた：動画（スマホの縦撮り、mp4）を public/videos/ に置き、下の posts に1件足す
//   video  … '/videos/ファイル名.mp4'（まだ無ければ省略。表紙の写真だけ出る）
//   poster … 表紙にする写真（src/assets/photos/ の画像）
// 掲載は、投稿者から掲載の許可をもらった動画だけにする
import { getImage } from 'astro:assets';
import { SITE } from '../data/site';
import p1 from '../assets/photos/amb-1.jpg';
import p2 from '../assets/photos/amb-2.jpg';
import p3 from '../assets/photos/amb-3.jpg';
import p4 from '../assets/photos/amb-4.jpg';

type Post = { account: string; pet: string; age: string; spot: string; poster: ImageMetadata; video?: string; color: string };
const posts: Post[] = [
  { account: 'mofu_poodle', pet: 'モフ', age: '2歳', spot: '雪のドッグラン', poster: p1, video: '/videos/amb-1.mp4', color: '#8a5a2b' },
  { account: 'nana_neko', pet: 'ナナ', age: '生後4か月', spot: 'リビングの窓辺', poster: p2, video: '/videos/amb-2.mp4', color: '#9a5c08' },
  { account: 'bon_lulu', pet: 'ボンとルル', age: '3歳・2歳', spot: 'リビングのソファ', poster: p3, video: '/videos/amb-3.mp4', color: '#4f6278' },
  { account: 'kuri_pome', pet: 'くり', age: '1歳', spot: 'おうちの玄関前', poster: p4, video: '/videos/amb-4.mp4', color: '#5c5249' },
];
const posters = await Promise.all(posts.map((p) => getImage({ src: p.poster, width: 540, height: 960, fit: 'cover', format: 'webp' })));
---
<section class="section amb" aria-labelledby="amb-title">
  <div class="container">
    <h2 id="amb-title" class="sec-title"><small>AMBASSADOR</small>うちの子ムービー</h2>
    <p class="lead">アンバサダーのみなさんから届いた、毎日のワンシーン。</p>
  </div>

  <div class="container nav">
    <button type="button" class="arrow toggle" aria-pressed="false" aria-label="自動で流れるのを止める"><span aria-hidden="true">Ⅱ</span></button>
    <button type="button" class="arrow" data-dir="-1" aria-label="前の動画へ"><span aria-hidden="true">‹</span></button>
    <button type="button" class="arrow" data-dir="1" aria-label="次の動画へ"><span aria-hidden="true">›</span></button>
  </div>
  <ul class="reel" aria-label="アンバサダーの動画">
    {[...posts, ...posts].map((p, n) => {
      const i = n % posts.length;
      const clone = n >= posts.length;
      return (
      <li class:list={['item', { clone }]} aria-hidden={clone ? 'true' : undefined}>
        <figure class="card">
          <div class="frame">
            {p.video
              ? <video class="media" src={p.video} poster={posters[i].src} muted loop playsinline preload="none" aria-label={`${p.pet}（${p.age}）の動画`}></video>
              : <img class="media" src={posters[i].src} width="540" height="960" alt={`${p.pet}（${p.age}）`} loading="lazy" decoding="async" />}
            {p.video
              ? <button type="button" class="play" aria-label={`${p.pet}の動画を再生`} tabindex={clone ? -1 : undefined}><span aria-hidden="true"></span></button>
              : <span class="badge">動画（仮）</span>}
          </div>
          <figcaption>
            <span class="acct">
              <span class="avatar" style={`background:${p.color}`} aria-hidden="true">{p.account.slice(0, 1).toUpperCase()}</span>
              <span class="acct-name">@{p.account}</span>
            </span>
            <span class="pet">{p.pet}<span class="age">{p.age}</span></span>
            <span class="spot">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
              <span class="visually-hidden">撮影スポット：</span>{p.spot}
            </span>
          </figcaption>
        </figure>
      </li>
      );
    })}
  </ul>

  <div class="container join">
    <p>あなたの子の動画も募集中です。スマホで縦に撮った10〜30秒の動画を、LINEから送ってください。</p>
    <a class="btn btn--ghost" href={SITE.lineUrl}>動画を投稿する（仮リンク）</a>
    <p class="note">※掲載は、投稿者の方から掲載の許可をいただいた動画のみです。アカウント名・名前・動画はテスト用の仮のものです。</p>
  </div>
</section>

<script>
  // タップで再生・一時停止。同時に再生するのは1本だけ。画面の外に出たら止める
  const vids = [...document.querySelectorAll<HTMLVideoElement>('.amb video')];
  const stopOthers = (v: HTMLVideoElement) => vids.forEach((o) => o !== v && o.pause());
  vids.forEach((v) => {
    const btn = v.parentElement!.querySelector<HTMLButtonElement>('.play')!;
    const label = btn.getAttribute('aria-label')!;
    btn.addEventListener('click', () => (v.paused ? (stopOthers(v), v.play()) : v.pause()));
    v.addEventListener('play', () => { btn.classList.add('is-playing'); btn.setAttribute('aria-label', label.replace('再生', '一時停止')); });
    v.addEventListener('pause', () => { btn.classList.remove('is-playing'); btn.setAttribute('aria-label', label); });
  });
  // 動画が並んでいると伝わるよう、右から左へゆっくり流す。列は2周分あり、1周分進んだら先頭に戻してつなげる
  // 指やマウスでさわっている間・再生中・画面の外にあるときは止める。動きを減らす設定の人には流さない
  const reel = document.querySelector<HTMLElement>('.amb .reel')!;
  const firstClone = reel.querySelector<HTMLElement>('.clone');
  const loopWidth = () => (firstClone ? firstClone.offsetLeft - (reel.firstElementChild as HTMLElement).offsetLeft : 0);
  const step = () => (reel.querySelector('.item') as HTMLElement).offsetWidth + parseFloat(getComputedStyle(reel).columnGap);
  const wrap = () => { const w = loopWidth(); if (w && reel.scrollLeft >= w) reel.scrollLeft -= w; };
  const SPEED = 30; // 1秒あたりのpx
  let pos = 0, last = 0, held = false, inView = false, resumeAt = 0, stopped = false;
  const playing = () => vids.some((v) => !v.paused);
  const tick = (t: number) => {
    const dt = last ? Math.min(t - last, 100) : 0;
    last = t;
    if (!stopped && !held && inView && !playing() && t >= resumeAt) {
      reel.classList.add('is-auto');
      pos += (SPEED * dt) / 1000;
      const w = loopWidth();
      if (w && pos >= w) pos -= w;
      reel.scrollLeft = pos;
    } else {
      reel.classList.remove('is-auto');
      pos = reel.scrollLeft;
    }
    requestAnimationFrame(tick);
  };
  // さわったら止め、離して3秒たったら再開する
  const hold = () => { held = true; reel.classList.remove('is-auto'); };
  const release = () => { held = false; resumeAt = performance.now() + 3000; wrap(); pos = reel.scrollLeft; };
  reel.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && hold());
  reel.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && release());
  reel.addEventListener('touchstart', hold, { passive: true });
  reel.addEventListener('touchend', release, { passive: true });
  reel.addEventListener('focusin', hold);
  reel.addEventListener('focusout', release);
  reel.addEventListener('scroll', () => { if (!reel.classList.contains('is-auto')) { wrap(); } }, { passive: true });

  // 矢印で1本ずつ送る（押したあとは少し待ってから流れを再開）
  document.querySelectorAll<HTMLButtonElement>('.amb .arrow[data-dir]').forEach((a) => a.addEventListener('click', () => {
    resumeAt = performance.now() + 4000;
    reel.classList.remove('is-auto');
    const dir = Number(a.dataset.dir);
    if (dir < 0 && reel.scrollLeft < step()) reel.scrollLeft += loopWidth();
    reel.scrollBy({ left: dir * step(), behavior: 'smooth' });
  }));

  // 止める・流すの切り替え（ずっと動くものには、止める手段を用意する）
  const toggle = document.querySelector<HTMLButtonElement>('.amb .toggle')!;
  toggle.addEventListener('click', () => {
    stopped = !stopped;
    toggle.setAttribute('aria-pressed', String(stopped));
    toggle.setAttribute('aria-label', stopped ? '自動で流す' : '自動で流れるのを止める');
    toggle.firstElementChild!.textContent = stopped ? '▶' : 'Ⅱ';
  });

  const autoOk = !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window;
  toggle.hidden = !autoOk;
  if (autoOk) {
    new IntersectionObserver((es) => { inView = es[0].isIntersecting; }).observe(reel);
    requestAnimationFrame(tick);
  }

  if (vids.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => !e.isIntersecting && (e.target as HTMLVideoElement).pause()));
    vids.forEach((v) => io.observe(v));
  }
</script>

<style>
  .amb { background: var(--c-bg-warm); overflow: hidden; }
  .lead { text-align: center; color: var(--c-text-sub); margin: -12px 0 20px; }

  /* 横スライダー：スマホはスワイプ、PCは矢印でも送れる。左端は本文の幅にそろえ、右は画面の端まで見せる */
  .reel {
    --edge: max(var(--gutter), calc((100vw - var(--w-wide)) / 2 + var(--gutter)));
    list-style: none; margin: 0; padding: 0 var(--edge) 8px; scroll-padding-inline: var(--edge);
    display: grid; grid-auto-flow: column; grid-auto-columns: min(64vw, 260px); gap: 14px;
    overflow-x: auto; scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .reel::-webkit-scrollbar { display: none; }
  @media (min-width: 960px) { .reel { grid-auto-columns: 280px; gap: 20px; } }

  .nav { display: flex; justify-content: flex-end; gap: 8px; margin-bottom: 14px; }
  .arrow {
    width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--c-text); background: #fff; color: var(--c-text);
    font-size: 1.5rem; line-height: 1; display: grid; place-items: center; cursor: pointer; transition: background .2s, color .2s, opacity .2s;
  }
  .arrow:hover:not(:disabled) { background: var(--c-text); color: #fff; }
  .toggle { font-size: 0.8125rem; margin-right: auto; }
  .toggle[hidden] { display: none; }

  /* 動画には文字を重ねない（投稿動画に入っている文字とぶつかるため）。情報は動画の下に出す */
  .card { margin: 0; }
  .frame { position: relative; aspect-ratio: 9 / 16; border-radius: 14px; overflow: hidden; background: #2a2622; }
  .media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  figcaption { display: grid; gap: 4px; padding: 12px 2px 0; }

  .acct { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .avatar {
    width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; flex: none;
    font-weight: 700; font-size: 0.75rem; color: #fff; box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--c-primary);
  }
  .acct-name { font-size: 0.8125rem; font-weight: 700; color: var(--c-text-sub); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pet { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; letter-spacing: 0.08em; margin-top: 4px; }
  .age { font-family: var(--font-body); font-size: 0.8125rem; font-weight: 700; margin-left: 8px; color: var(--c-text-sub); }
  .spot { display: flex; align-items: center; gap: 4px; font-size: 0.8125rem; color: var(--c-text-sub); }
  .spot svg { width: 14px; height: 14px; flex: none; color: var(--c-primary); }

  .play { position: absolute; z-index: 2; inset: 0; background: none; border: 0; cursor: pointer; display: grid; place-items: center; }
  .play span { width: 56px; height: 56px; border-radius: 50%; background: rgba(0,0,0,.35); border: 2px solid #fff; position: relative; transition: opacity .3s; }
  .play span::after { content: ''; position: absolute; left: 21px; top: 16px; border-left: 18px solid #fff; border-top: 11px solid transparent; border-bottom: 11px solid transparent; }
  .play.is-playing span { opacity: 0; }
  .badge { position: absolute; z-index: 2; right: 10px; top: 14px; font-size: 0.6875rem; font-weight: 700; background: rgba(255,255,255,.9); color: var(--c-text); padding: 2px 8px; border-radius: 999px; }

  .join { text-align: center; margin-top: 32px; }
  .join p { margin: 0 0 16px; font-size: 0.9375rem; color: var(--c-text-sub); }
  .join .note { font-size: 0.75rem; margin: 16px 0 0; }
</style>
