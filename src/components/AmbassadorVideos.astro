---
// アンバサダー（飼い主さん）から集めた縦長動画の投稿枠
// 追加のしかた：動画（スマホの縦撮り、mp4）を public/videos/ に置き、下の posts に1件足す
//   video  … '/videos/ファイル名.mp4'（まだ無ければ省略。表紙の写真だけ出る）
//   poster … 表紙にする写真（src/assets/photos/ の画像）
// 掲載は、投稿者から掲載の許可をもらった動画だけにする
import { getImage } from 'astro:assets';
import { SITE } from '../data/site';
import p1 from '../assets/photos/worry-food.jpg';
import p2 from '../assets/photos/worry-living.jpg';
import p3 from '../assets/photos/worry-senior.jpg';
import p4 from '../assets/photos/category-living.jpg';

type Post = { account: string; pet: string; age: string; spot: string; poster: ImageMetadata; video?: string; color: string };
const posts: Post[] = [
  { account: 'choco_mama', pet: 'チョコ', age: '1歳', spot: '近所の公園', poster: p1, color: '#8a5a2b' },
  { account: 'sora.days', pet: 'ソラ', age: '5歳', spot: 'リビングのクッション', poster: p2, color: '#4f6278' },
  { account: 'mugi_neko', pet: 'むぎ', age: '12歳', spot: 'ひだまりの床', poster: p3, color: '#9a5c08' },
  { account: 'ash_and_me', pet: 'アッシュ', age: '3歳', spot: 'キャットタワーのてっぺん', poster: p4, color: '#5c5249' },
];
const posters = await Promise.all(posts.map((p) => getImage({ src: p.poster, width: 540, height: 960, fit: 'cover', format: 'webp' })));
---
<section class="section amb" aria-labelledby="amb-title">
  <div class="container">
    <h2 id="amb-title" class="sec-title"><small>AMBASSADOR</small>うちの子ムービー</h2>
    <p class="lead">アンバサダーのみなさんから届いた、毎日のワンシーン。</p>
  </div>

  <ul class="reel" aria-label="アンバサダーの動画">
    {posts.map((p, i) => (
      <li class="item">
        <figure class="card">
          {p.video
            ? <video class="media" src={p.video} poster={posters[i].src} muted loop playsinline preload="none" aria-label={`${p.pet}（${p.age}）の動画`}></video>
            : <img class="media" src={posters[i].src} width="540" height="960" alt={`${p.pet}（${p.age}）`} loading="lazy" decoding="async" />}
          <figcaption>
            <span class="acct">
              <span class="avatar" style={`background:${p.color}`} aria-hidden="true">{p.account.slice(0, 1).toUpperCase()}</span>
              <span class="acct-name">@{p.account}</span>
            </span>
            <span class="info">
              <span class="pet">{p.pet}<span class="age">{p.age}</span></span>
              <span class="spot">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
                <span class="visually-hidden">撮影スポット：</span>{p.spot}
              </span>
            </span>
          </figcaption>
          {p.video
            ? <button type="button" class="play" aria-label={`${p.pet}の動画を再生`}><span aria-hidden="true"></span></button>
            : <span class="badge">動画（仮）</span>}
        </figure>
      </li>
    ))}
  </ul>

  <div class="container join">
    <p>あなたの子の動画も募集中です。スマホで縦に撮った10〜30秒の動画を、LINEから送ってください。</p>
    <a class="btn btn--ghost" href={SITE.lineUrl}>動画を投稿する（仮リンク）</a>
    <p class="note">※掲載は、投稿者の方から掲載の許可をいただいた動画のみです。アカウント名・名前・動画はテスト用の仮のものです。</p>
  </div>
</section>

<script>
  // タップで再生・一時停止。同時に再生するのは1本だけ。画面の外に出たら止める
  const vids = [...document.querySelectorAll<HTMLVideoElement>('.amb video')];
  const stopOthers = (v: HTMLVideoElement) => vids.forEach((o) => o !== v && o.pause());
  vids.forEach((v) => {
    const btn = v.parentElement!.querySelector<HTMLButtonElement>('.play')!;
    const label = btn.getAttribute('aria-label')!;
    btn.addEventListener('click', () => (v.paused ? (stopOthers(v), v.play()) : v.pause()));
    v.addEventListener('play', () => { btn.classList.add('is-playing'); btn.setAttribute('aria-label', label.replace('再生', '一時停止')); });
    v.addEventListener('pause', () => { btn.classList.remove('is-playing'); btn.setAttribute('aria-label', label); });
  });
  if (vids.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => !e.isIntersecting && (e.target as HTMLVideoElement).pause()));
    vids.forEach((v) => io.observe(v));
  }
</script>

<style>
  .amb { background: var(--c-bg-warm); overflow: hidden; }
  .lead { text-align: center; color: var(--c-text-sub); margin: -12px 0 32px; }

  /* スマホは横にスワイプ、PCは4列 */
  .reel {
    list-style: none; margin: 0; padding: 0 var(--gutter) 8px; display: grid; grid-auto-flow: column;
    grid-auto-columns: min(64vw, 260px); gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
  }
  .item { scroll-snap-align: center; }
  @media (min-width: 960px) {
    .reel { max-width: var(--w-wide); margin: 0 auto; grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); overflow: visible; gap: 20px; }
  }

  .card { position: relative; margin: 0; aspect-ratio: 9 / 16; border-radius: 14px; overflow: hidden; background: #2a2622; color: #fff; }
  .media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .card::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(0,0,0,.45) 0%, rgba(0,0,0,0) 22%, rgba(0,0,0,0) 60%, rgba(0,0,0,.65) 100%); }
  figcaption { position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; justify-content: space-between; padding: 12px; pointer-events: none; }

  .acct { display: flex; align-items: center; gap: 8px; }
  .avatar {
    width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; flex: none;
    font-weight: 700; font-size: 0.875rem; color: #fff; box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--c-primary);
  }
  .acct-name { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.02em; text-shadow: 0 1px 4px rgba(0,0,0,.5); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .info { display: grid; gap: 2px; }
  .pet { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; letter-spacing: 0.08em; text-shadow: 0 1px 6px rgba(0,0,0,.5); }
  .age { font-family: var(--font-body); font-size: 0.8125rem; font-weight: 700; margin-left: 8px; }
  .spot { display: flex; align-items: center; gap: 4px; font-size: 0.8125rem; text-shadow: 0 1px 4px rgba(0,0,0,.5); }
  .spot svg { width: 14px; height: 14px; flex: none; color: var(--c-primary); }

  .play { position: absolute; z-index: 2; inset: 0; background: none; border: 0; cursor: pointer; display: grid; place-items: center; }
  .play span { width: 56px; height: 56px; border-radius: 50%; background: rgba(0,0,0,.35); border: 2px solid #fff; position: relative; transition: opacity .3s; }
  .play span::after { content: ''; position: absolute; left: 21px; top: 16px; border-left: 18px solid #fff; border-top: 11px solid transparent; border-bottom: 11px solid transparent; }
  .play.is-playing span { opacity: 0; }
  .badge { position: absolute; z-index: 2; right: 10px; top: 14px; font-size: 0.6875rem; font-weight: 700; background: rgba(255,255,255,.9); color: var(--c-text); padding: 2px 8px; border-radius: 999px; }

  .join { text-align: center; margin-top: 32px; }
  .join p { margin: 0 0 16px; font-size: 0.9375rem; color: var(--c-text-sub); }
  .join .note { font-size: 0.75rem; margin: 16px 0 0; }
</style>
