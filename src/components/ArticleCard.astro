---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { categoryName, formatDate } from '../data/site';
import Tags from './Tags.astro';

interface Props { article: CollectionEntry<'articles'>; }
const { article } = Astro.props;
const d = article.data;
---
<article class="card">
  <a class="card-link" href={`/articles/${article.id}/`}>
    <div class="card-img">
      <Image src={d.hero} alt="" widths={[400, 720]} sizes="(min-width: 960px) 360px, (min-width: 640px) 50vw, 100vw" />
      <span class="tag tag--cat-label">{categoryName(d.category)}</span>
    </div>
    <div class="card-body">
      <h3 class="card-title">{d.title}</h3>
      <p class="card-date"><time datetime={d.publishDate.toISOString()}>{formatDate(d.publishDate)}</time></p>
    </div>
  </a>
  <div class="card-tags"><Tags animal={d.animal} ages={d.ages} /></div>
</article>

<style>
  .card { background: #fff; border-radius: var(--radius-m); box-shadow: var(--shadow-card); overflow: hidden; display: flex; flex-direction: column; }
  .card-link { color: var(--c-text); text-decoration: none; }
  .card-img { position: relative; aspect-ratio: 3 / 2; overflow: hidden; }
  .card-img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
  .card-link:hover .card-img :global(img) { transform: scale(1.04); }
  .card-img .tag { position: absolute; left: 12px; top: 12px; }
  .card-body { padding: 16px 20px 4px; }
  .card-title { font-size: 1.05rem; margin: 0 0 6px; line-height: 1.6; }
  .card-link:hover .card-title { color: var(--c-primary-ink); }
  .card-date { font-size: 0.8125rem; color: var(--c-text-sub); margin: 0; }
  .card-tags { padding: 8px 20px 20px; margin-top: auto; }
</style>
