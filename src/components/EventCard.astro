---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { event: CollectionEntry<'events'>; }
const { event } = Astro.props;
const d = event.data;
---
<a class="ev" href={`/events/${event.id}/`}>
  <span class="ev-img">
    <Image src={d.image} alt="" widths={[400, 720]} sizes="(min-width: 768px) 360px, 100vw" />
    <span class:list={['ev-kind', { 'is-event': d.kind === 'イベント' }]}>{d.kind}</span>
  </span>
  <span class="ev-body">
    <span class="ev-title">{d.title}</span>
    <span class="ev-meta">{d.period}</span>
    <span class="ev-meta">会場：{d.place}</span>
  </span>
</a>

<style>
  .ev { display: grid; grid-template-columns: 40% 1fr; gap: 14px; align-items: start; color: var(--c-text); text-decoration: none; background: #fff; border: 1px solid var(--c-line); padding: 12px; height: 100%; }
  @media (min-width: 768px) { .ev { grid-template-columns: 44% 1fr; gap: 18px; padding: 16px; } }
  .ev-img { position: relative; display: block; }
  .ev-img :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .ev-kind { position: absolute; left: 0; top: 0; background: var(--c-primary); color: #3a2200; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.1em; padding: 3px 8px; }
  .ev-kind.is-event { background: var(--c-accent-strong); color: #fff; }
  .ev-body { display: grid; gap: 6px; }
  .ev-title { font-weight: 700; font-size: 0.9375rem; line-height: 1.6; }
  .ev:hover .ev-title { color: var(--c-primary-ink); }
  .ev-meta { font-size: 0.75rem; color: var(--c-text-sub); line-height: 1.6; }
</style>
