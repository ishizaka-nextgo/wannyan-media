---
import '../styles/global.css';
import { SITE, CATEGORIES } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string; // シェア用の画像（なければ共通の画像）
}
const { title, description = SITE.tagline, image = '/og-default.jpg' } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const path = Astro.url.pathname;
const FONTS = 'https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Shippori+Mincho:wght@500;600;700&display=swap';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- テストサイトのため検索エンジンに載せない（本番で外す） -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <!-- LINE・SNSでURLを送ったときのカード表示 -->
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- JSが動くときだけ「ふわっと表示」の初期状態にする（動かなければ普通に表示） -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 日本語フォントのCSSは大きく描画を止めるため、後から読み込む（その間は端末の標準書体で表示） -->
    <link rel="preload" as="style" href={FONTS} />
    <link rel="stylesheet" href={FONTS} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={FONTS} /></noscript>
  </head>
  <body>
    <div class="test-band" role="note">テストサイト（公開前の確認用）</div>
    <a class="skip" href="#main">本文へスキップ</a>
    <slot name="hero" />

    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href="/" aria-label={`${SITE.name} トップへ`}>
          <svg class="logo-mark" viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" fill="var(--c-primary)"/><g fill="#fff"><ellipse cx="20" cy="25" rx="7" ry="6"/><circle cx="11.5" cy="17" r="3.2"/><circle cx="17" cy="11.5" r="3.2"/><circle cx="23" cy="11.5" r="3.2"/><circle cx="28.5" cy="17" r="3.2"/></g></svg>
          <span class="logo-text"><small>ワンニャンハウス</small>ペットのくらし手帖</span>
        </a>
        <nav class="header-links" aria-label="サイト情報">
          <a href="/about/">このメディアについて</a>
          <button type="button" class="menu-btn" aria-haspopup="dialog" aria-controls="site-menu"><span class="menu-icon" aria-hidden="true"></span>メニュー</button>
        </nav>
      </div>
      <nav class="cat-nav" aria-label="カテゴリー">
        <ul class="container">
          {CATEGORIES.map((c) => {
            const href = `/category/${c.slug}/`;
            return <li><a href={href} aria-current={path === href ? 'page' : undefined}>{c.name}</a></li>;
          })}
          <li><a href="/breeds/" aria-current={path.startsWith('/breeds/') ? 'page' : undefined}>犬種・猫種図鑑</a></li>
        </ul>
      </nav>
    </header>

    <dialog id="site-menu" class="menu" aria-label="メニュー">
      <div class="menu-head">
        <p class="menu-title">MENU</p>
        <button type="button" class="menu-close" aria-label="メニューを閉じる"><span aria-hidden="true">×</span></button>
      </div>
      <nav aria-label="メニュー">
        <ul class="menu-main">
          <li><a href="/articles/welcome-guide/">はじめてのお迎えガイド</a></li>
          <li><a href="/breeds/">犬種・猫種図鑑</a></li>
          <li><a href="/events/">イベント・キャンペーン</a></li>
        </ul>
        <p class="menu-label">カテゴリー</p>
        <ul class="menu-cats">{CATEGORIES.map((c) => <li><a href={`/category/${c.slug}/`}>{c.name}</a></li>)}</ul>
        <ul class="menu-sub">
          <li><a href={SITE.storesUrl}>店舗一覧（仮リンク）</a></li>
          <li><a href="/about/">このメディアについて</a></li>
          <li><a href="/contact/">お問い合わせ</a></li>
        </ul>
        <a class="menu-line" href={SITE.lineUrl}>LINEで友だち追加（仮リンク）</a>
      </nav>
    </dialog>
    <script>
      const menu = document.getElementById('site-menu') as HTMLDialogElement;
      document.querySelector('.menu-btn')!.addEventListener('click', () => menu.showModal());
      menu.querySelector('.menu-close')!.addEventListener('click', () => menu.close());
      // 背景（メニューの外）を押したら閉じる
      menu.addEventListener('click', (e) => { if (e.target === menu) menu.close(); });
    </script>

    <main id="main"><slot /></main>
    <script>
      // スクロールで画面に入った要素を、ふわっと表示する。動きを減らす設定の人には使わない
      const targets = document.querySelectorAll<HTMLElement>(
        '[data-reveal], .sec-title, .intro-lead, .intro-text, .worries > li, .card, .cat-main > li, .prose > h2, .store-body'
      );
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        targets.forEach((el, i) => {
          el.classList.add('reveal');
          el.style.setProperty('--delay', `${(i % 4) * 0.08}s`);
          io.observe(el);
        });
      }
    </script>

    <p class="tbd-toast" role="status" aria-live="polite"></p>
    <script>
      // 仮リンク（#○○-tbd）を押したら、本番で何につながるかを小さく知らせる。テストサイトの間だけの仕組み
      const TBD: Record<string, string> = {
        stores: '店舗一覧ページ', line: 'LINE公式アカウントの友だち追加', shop: 'オンラインショップ',
      };
      const toast = document.querySelector<HTMLElement>('.tbd-toast')!;
      let hideTimer = 0;
      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest<HTMLAnchorElement>('a[href$="-tbd"]');
        if (!a) return;
        e.preventDefault();
        const key = a.getAttribute('href')!.slice(1, -4);
        toast.textContent = `本番では「${TBD[key] ?? '正式なページ'}」につながります`;
        toast.classList.add('is-show');
        clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => toast.classList.remove('is-show'), 2600);
      });
    </script>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-logo">{SITE.name}<span>（仮称）</span></p>
        <p class="footer-lead">{SITE.tagline}</p>
        <ul class="footer-links">
          <li><a href="/articles/welcome-guide/">はじめてのお迎えガイド</a></li>
          <li><a href="/breeds/">犬種・猫種図鑑</a></li>
          <li><a href="/events/">イベント・キャンペーン</a></li>
          <li><a href="/about/">このメディアについて</a></li>
          <li><a href="/contact/">お問い合わせ</a></li>
          <li><a href="/privacy/">プライバシーポリシー</a></li>
          <li><a href={SITE.storesUrl}>店舗一覧（仮リンク）</a></li>
        </ul>
        <p class="copy"><small>&copy; {SITE.company}　写真はテスト用の仮素材です。</small></p>
      </div>
    </footer>
  </body>
</html>

<style>
  .tbd-toast {
    position: fixed; z-index: 50; left: 50%; bottom: 24px; transform: translate(-50%, 16px); margin: 0;
    width: max-content; max-width: calc(100vw - 32px); padding: 12px 20px; background: rgba(40, 32, 26, .92); color: #fff;
    font-size: 0.875rem; line-height: 1.6; text-align: center; border-radius: 999px; opacity: 0; pointer-events: none; transition: opacity .25s, transform .25s;
  }
  .tbd-toast.is-show { opacity: 1; transform: translate(-50%, 0); }
  .test-band {
    background: var(--c-text); color: #fff; text-align: center;
    font-size: 0.8125rem; font-weight: 700; padding: 4px 8px; letter-spacing: 0.08em;
  }
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 8px; top: 8px; z-index: 10; background: #fff; padding: 8px 12px; }

  /* B案：白地に細い罫線。スクロールしてもメニューが上に残る */
  .site-header { background: rgba(255,255,255,.96); border-bottom: 1px solid var(--c-line); position: sticky; top: 0; z-index: 20; backdrop-filter: blur(6px); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-block: 12px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--c-text); }
  .logo-mark { width: 32px; height: 32px; flex: none; }
  .logo-text { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; line-height: 1.35; white-space: nowrap; letter-spacing: 0.1em; }
  @media (min-width: 768px) { .logo-text { font-size: 1.2rem; } }
  .logo-text small { display: block; font-family: var(--font-body); font-size: 0.65rem; color: var(--c-text-sub); letter-spacing: 0.2em; }
  .header-links { display: flex; align-items: center; gap: 24px; font-size: 0.875rem; }
  .header-links a { color: var(--c-text); text-decoration: none; letter-spacing: 0.08em; }
  .header-links > a { display: none; }
  @media (min-width: 768px) { .header-links > a { display: inline; } }
  .menu-btn {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; background: none;
    border: 1px solid var(--c-text); color: var(--c-text); font: inherit; font-size: 0.8125rem; letter-spacing: 0.08em; cursor: pointer; white-space: nowrap;
  }
  .menu-btn:hover { background: var(--c-text); color: #fff; }
  .menu-icon, .menu-icon::before, .menu-icon::after { display: block; width: 16px; height: 1.5px; background: currentColor; position: relative; }
  .menu-icon::before, .menu-icon::after { content: ''; position: absolute; left: 0; }
  .menu-icon::before { top: -5px; }
  .menu-icon::after { top: 5px; }

  /* メニュー：右から出るパネル */
  .menu { margin: 0 0 0 auto; height: 100dvh; max-height: none; width: min(88vw, 400px); border: 0; padding: 0 24px 40px; background: #fff; color: var(--c-text); overflow-y: auto; }
  .menu::backdrop { background: rgba(30, 24, 18, .45); }
  .menu[open] { animation: menu-in .25s ease-out; }
  @keyframes menu-in { from { transform: translateX(30px); opacity: 0; } }
  .menu-head { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--c-line); }
  .menu-title { margin: 0; font-size: 0.8125rem; letter-spacing: 0.3em; color: var(--c-text-sub); }
  .menu-close { width: 44px; height: 44px; border: 0; background: none; font-size: 1.75rem; line-height: 1; cursor: pointer; color: var(--c-text); }
  .menu ul { list-style: none; padding: 0; margin: 0; }
  .menu a { color: var(--c-text); text-decoration: none; }
  .menu-main a { display: block; padding: 16px 0; border-bottom: 1px solid var(--c-line); font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; letter-spacing: 0.08em; }
  .menu-label { margin: 24px 0 4px; font-size: 0.75rem; font-weight: 700; color: var(--c-primary-ink); letter-spacing: 0.15em; }
  .menu-cats a { display: block; padding: 11px 0; border-bottom: 1px dashed var(--c-line); font-size: 0.9375rem; }
  .menu-sub { margin-top: 24px !important; display: grid; gap: 4px; }
  .menu-sub a { display: block; padding: 8px 0; font-size: 0.875rem; color: var(--c-text-sub); }
  .menu a:hover { color: var(--c-primary-ink); }
  .menu-line { display: flex; justify-content: center; align-items: center; min-height: 52px; margin-top: 24px; background: #06c755; color: #062b14 !important; font-weight: 700; border-radius: 2px; }
  @media (prefers-reduced-motion: reduce) { .menu[open] { animation: none; } }

  /* カテゴリーは文字だけのメニュー。スマホは横にスクロール */
  .cat-nav ul {
    display: flex; gap: 4px 22px; list-style: none; margin: 0; padding-block: 0 4px;
    overflow-x: auto; scrollbar-width: none;
  }
  .cat-nav li { flex: none; }
  .cat-nav a {
    display: block; padding: 8px 0 10px; color: var(--c-text-sub); font-size: 0.8125rem; letter-spacing: 0.06em;
    text-decoration: none; white-space: nowrap; border-bottom: 2px solid transparent;
  }
  .cat-nav a[aria-current='page'], .cat-nav a:hover { color: var(--c-text); border-color: var(--c-primary); }

  .site-footer { background: #2a2622; color: #f3eee7; margin-top: var(--space-section); padding-block: 56px 32px; }
  .footer-logo { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; letter-spacing: 0.1em; margin: 0; }
  .footer-logo span { font-size: 0.8rem; color: #c9c0b4; }
  .footer-lead { font-size: var(--fs-small); color: #c9c0b4; margin: 6px 0 24px; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 8px 24px; list-style: none; padding: 0; margin: 0 0 28px; font-size: 0.875rem; }
  .footer-links a { color: #f3eee7; }
  .copy { color: #c9c0b4; margin: 0; }
</style>
